# SEC EDGAR fair-access policy requires a contact email in request headers
SEC_EDGAR_CONTACT_EMAIL=

# Financial Modeling Prep — free tier (financialmodelingprep.com) used to pull
# Senate STOCK Act disclosures (efdsearch.senate.gov blocks non-browser
# requests, so this is a workaround rather than scraping it directly).
FMP_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:3000 for local dev — set this in production
# (e.g. Railway) to the deployed frontend's public URL.
CORS_ALLOWED_ORIGINS=

# Shared secret gating the /refresh endpoints and /api/status. Leaving this
# unset locks those endpoints rather than skipping the check.
ADMIN_API_KEY=

# Same value as the frontend's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (Clerk
# dashboard -> API Keys). Used to derive Clerk's Frontend API host so
# app/auth_clerk.py can verify session tokens via JWKS. Also requires the
# Clerk Dashboard's session token to include an `email` custom claim
# (Dashboard -> Sessions -> Customize session token).
CLERK_PUBLISHABLE_KEY=

# resend.com — sends watchlist-alert emails (app/notifications/email.py).
# Without these set, alert emails are skipped (logged, not an error) — the
# watchlist itself still works, just without notifications going out.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
