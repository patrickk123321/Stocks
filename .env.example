# SEC EDGAR fair-access policy requires a contact email in request headers
SEC_EDGAR_CONTACT_EMAIL=

# Alpaca paper trading — used by Product 3 (Auto-Trading Bot). Sign up for a
# free paper-trading account at alpaca.markets and use its API keys here (not
# live-trading keys — this app only ever connects in paper mode).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Financial Modeling Prep — free tier (financialmodelingprep.com) used to pull
# Senate STOCK Act disclosures (efdsearch.senate.gov blocks non-browser
# requests, so this is a workaround rather than scraping it directly).
FMP_API_KEY=

# Anthropic API — used by Product 2 (Portfolio Recommendations) to parse a
# portfolio screenshot upload into structured holdings via Claude's vision API.
ANTHROPIC_API_KEY=
